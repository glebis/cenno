{
  "name": "cenno-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens": "cp ../src/styles/tokens.css src/styles/tokens.css 2>/dev/null || echo 'tokens: source repo not present, using committed snapshot'",
    "predev": "npm run tokens",
    "dev": "astro dev",
    "prebuild": "npm run tokens",
    "build": "astro build",
    "preview": "astro preview",
    "widgets": "NODE_PATH=../node_modules ../node_modules/.bin/vite build --config widgets/vite.config.ts"
  },
  "dependencies": {
    "astro": "^5.0.0"
  }
}
